{% extends "ci-infrastructure/python-runner.sh.j2" %}
{% block set_environment %}
# findlibs finds eccodes, odc, metkit, and fdb from their *_HOME; each dep has its own prefix.
IFS=';:' read -ra dep_prefixes <<<"${CMAKE_PREFIX_PATH:-}"
for prefix in ${dep_prefixes[@]+"${dep_prefixes[@]}"}; do
  if compgen -G "$prefix/lib*/libeccodes.*" >/dev/null; then
    export ECCODES_HOME="$prefix"
    export ECCODES_DEFINITION_PATH="$prefix/share/eccodes/definitions"
    export ECCODES_SAMPLES_PATH="$prefix/share/eccodes/samples"
  fi
  if compgen -G "$prefix/lib*/libodccore.*" >/dev/null; then
    export ODC_HOME="$prefix"
  fi
  if compgen -G "$prefix/lib*/libmetkit.*" >/dev/null; then
    export METKIT_HOME="$prefix"
  fi
  if compgen -G "$prefix/lib*/libfdb5.*" >/dev/null; then
    export FDB5_HOME="$prefix"
  fi
done
export FINDLIBS_DISABLE_PACKAGE=yes

# The Rust extension (setuptools-rust) needs cargo, which the container lacks.
rust_root="${RUNNER_TEMP:-${TMPDIR:-/tmp}}"
export CARGO_TARGET_DIR="$rust_root/cargo"
if ! command -v cargo >/dev/null; then
  export RUSTUP_HOME="$rust_root/rustup" CARGO_HOME="$rust_root/cargo-home"
  curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y --profile minimal --no-modify-path
  export PATH="$CARGO_HOME/bin:$PATH"
fi
export CC="$(command -v {{ c_compiler_binary | sh }})" CXX="$(command -v {{ cxx_compiler_binary | sh }})"
host="$(rustc -vV | sed -n 's/^host: //p')"
export "CARGO_TARGET_$(tr 'a-z-' 'A-Z_' <<<"$host")_LINKER=$CC"
# Build the extension, and make the tests use it rather than the pure-Python fallback.
export USE_RUST=1
{% endblock %}
{% block test_requirements %}pytest pytest-cov{% endblock %}
{% block test %}
cd "$CI_SOURCE_DIR"
# Not python -m pytest: that would put the source tree, which lacks the Rust extension, on sys.path.
pytest --cov-report term --cov-report xml:coverage.xml --cov ./
python -m coverage report
{% endblock %}
